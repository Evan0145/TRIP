rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 是否為該群組成員
    function isMember(gid) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
    }

    // 邀請碼:登入後才能用「碼」查詢單一筆(不能列出全部);只能新增,不能改或刪(避免被覆蓋)
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /groups/{gid} {
      // 只有群組成員讀得到群組資料
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;

      // 建立:必須登入,且自己是擁有者與第一位成員
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      allow update: if request.auth != null && (
        // 成員可以修改群組內容,但不能增減成員名單
        (request.auth.uid in resource.data.memberUids
          && request.resource.data.memberUids == resource.data.memberUids)
        ||
        // 任何登入者可以「把自己加進去」(憑邀請碼取得群組 ID),不能動別人
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberNames'])
          && request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()) == [request.auth.uid].toSet()
          && resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()) == [].toSet())
      );

      allow delete: if false;

      // 旅程與支出:只有群組成員能讀寫
      match /trips/{tid} {
        allow read, write: if isMember(gid);
      }
    }
  }
}
